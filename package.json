{
  "name": "game-arcade",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "expo install expo-router react-native react-dom react-native-safe-area-context react-native-screens expo-linking expo-constants expo-status-bar expo-haptics expo-font @expo-google-fonts/archivo react-native-reanimated react-native-gesture-handler @react-native-async-storage/async-storage && npm i zustand && expo install --fix",
    "start": "expo start",
    "android": "expo run:android",
    "new-game": "node scripts/new-game.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.2.4",
    "expo": "latest",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "typescript": "~6.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
